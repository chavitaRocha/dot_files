{
	"dev": {
		"lsp_document_colors": "inlay"
	},
	"telemetry": {
		"metrics": false,
		"diagnostics": false
	},
	"agent": {
		"default_model": {
			"provider": "zed.dev",
			"model": "claude-sonnet-4"
		}
	},
	"tab_bar": {
		"show": true
	},
	"edit_predictions": {
		"disabled_globs": [
			".env",
			"src/main.rs",
			"iteration/repeat.go",
			"structures/sum.go",
			"structures/sum_test.go"
		]
	},
	"preview_tabs": {
		"enable_preview_from_file_finder": true,
		"enable_preview_from_code_navigation": true
	},
	"experimental.theme_overrides": {
		// "background.appearance": "blurred",
		// "background": "#FFFFFFaa",
		// 	"editor.background": "#FFFFFF30"
	},
	"restore_on_startup": "last_workspace",
	"vim_mode": true,
	"vim": {
		"use_system_clipboard": "on_yank"
	},
	"auto_update": false,
	"theme": {
		"mode": "system",
		"dark": "Catppuccin Frappé",
		"light": "Catppuccin Latte"
	},
	"base_keymap": "VSCode",
	"agent_font_size": 18,
	"ui_font_size": 17,
	"buffer_font_size": 16.0,
	"relative_line_numbers": true,
	"soft_wrap": "editor_width",
	"active_pane_modifiers": {
		"border_size": 0.1,
		"inactive_opacity": 0.8
	},
	"tabs": {
		"file_icons": true
	},
	"features": {
		"edit_prediction_provider": "zed"
	},
	"vertical_scroll_margin": 35,
	"project_panel": {
		"dock": "right"
	},
	"terminal": {
		"dock": "right",
		"copy_on_select": true,
		"font_family": "JetBrainsMono Nerd Font"
	},
	"formatter": {
		"language_server": {
			"name": "biome"
		}
	},
	"code_actions_on_format": {
		"source.fixAll.biome": true,
		"source.organizeImports.biome": true
	},
	"languages": {
		"TypeScript": {
			"linked_edits": true,
			"language_servers": [
				"vtsls",
				"biome",
				"typos",
				"tailwindcss-language-server",
				"eslint"
			]
		},
		"TSX": {
			"linked_edits": true,
			"language_servers": [
				"vtsls",
				"biome",
				"typos",
				"tailwindcss-language-server",
				"eslint"
			]
		},
		"JavaScript": {
			"linked_edits": true,
			"language_servers": [
				"vtsls",
				"biome",
				"typos",
				"tailwindcss-language-server"
			]
		}
	},
	"lsp": {
		"typos": {
			"initialization_options": {
				"config": ".typos.toml",
				"path": "typos-lsp",
				"diagnosticSeverity": "Error", // "Error", "Hint", "Information", "Warning"
				"logLevel": "info", // "debug", "error", "info", "off", "trace", "warn"
				"trace.server": "messages" // "off", "messages", "verbose"
			}
		},
		"biome": {
			"settings": {
				"configuration_path": "./biome.json"
			}
		},
		"vtsls": {
			"settings": {
				"javascript": {
					"inlayHints": {
						"parameterNames": {
							"enabled": "all",
							"suppressWhenArgumentMatchesName": false
						},
						"parameterTypes": {
							"enabled": true
						},
						"variableTypes": {
							"enabled": true,
							"suppressWhenTypeMatchesName": true
						},
						"propertyDeclarationTypes": {
							"enabled": true
						},
						"functionLikeReturnTypes": {
							"enabled": true
						},
						"enumMemberValues": {
							"enabled": true
						}
					}
				},
				"typescript": {
					"inlayHints": {
						"parameterNames": {
							"enabled": "all",
							"suppressWhenArgumentMatchesName": false
						},
						"parameterTypes": {
							"enabled": true
						},
						"variableTypes": {
							"enabled": true,
							"suppressWhenTypeMatchesName": true
						},
						"propertyDeclarationTypes": {
							"enabled": true
						},
						"functionLikeReturnTypes": {
							"enabled": true
						},
						"enumMemberValues": {
							"enabled": true
						}
					}
				}
			}
		},
		"gopls": {
			"initialization_options": {
				"hints": {
					"assignVariableTypes": true,
					"compositeLiteralFields": true,
					"compositeLiteralTypes": true,
					"constantValues": true,
					"functionTypeParameters": true,
					"parameterNames": true,
					"rangeVariableTypes": true
				}
			}
		}
	}
}
