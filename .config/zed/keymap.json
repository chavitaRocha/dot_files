[
  {
    "context": "Editor",
    "bindings": {
      "ctrl-l": null
    }
  },
  {
    "context": "vim_mode == literal",
    "bindings": {
      "ctrl-l": null
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-k cmd-left": null
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-h": null
    }
  },
  {
    "context": "Picker > Editor",
    "bindings": {
      "ctrl-h": null
    }
  },
  {
    "context": "vim_mode == literal",
    "bindings": {
      "ctrl-h": null
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft"
    }
  },
  {
    "context": "(VimControl || (!Editor && !Terminal))",
    "bindings": {
      "ctrl-k": "workspace::ActivatePaneUp"
    }
  },
  {
    "context": "(VimControl || (!Editor && !Terminal))",
    "bindings": {
      "ctrl-j": "workspace::ActivatePaneDown"
    }
  },
  {
    "context": "(VimControl || (!Editor && !Terminal))",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft"
    }
  },
  {
    "context": "(VimControl || (!Editor && !Terminal))",
    "bindings": {
      "ctrl-l": "workspace::ActivatePaneRight"
    }
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "space s f": "file_finder::Toggle",
      "-": "project_panel::ToggleFocus",
      "space e h": "workspace::CloseAllDocks",
      "space s g": "workspace::NewSearch",
      "space r n": "editor::Rename",
      "space g d": "editor::GoToDefinitionSplit",
      "space e g": "command_palette::Toggle",
      "space t": "terminal_panel::Toggle",
      "shift-k": "editor::Hover",
      "m l": [
        "tab_switcher::Toggle",
        {
          "select_last": false
        }
      ],
      "m m": "pane::TogglePinTab",
      ";": "command_palette::Toggle"
    }
  },
  {
    "context": "Editor && vim_mode == visual && !VimWaiting && !menu",
    "bindings": {
      "shift-k": "editor::MoveLineUp",
      "shift-j": "editor::MoveLineDown"
    }
  },
  {
    "context": "(VimControl && !menu)",
    "bindings": {
      "g h": null
    }
  },
  {
    "context": "(VimControl && !menu)",
    "bindings": {
      "g h": null
    }
  },
  {
    "context": "Editor && VimControl && !VimWaiting && !menu",
    "bindings": {
      "shift-h": "pane::ActivatePreviousItem",
      "shift-l": "pane::ActivateNextItem"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-t": null
    }
  },
  {
    "context": "Workspace || (Editor && vim_mode == normal)",
    "bindings": {
      "cmd-t": "workspace::NewCenterTerminal"
    }
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "space c c": "agent::ToggleFocus"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-y": null
    }
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "space f": "editor::Format"
    }
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "space f a": "editor::ToggleCodeActions"
    }
  },
  {
    "context": "(Editor && showing_completions)",
    "bindings": {
      "ctrl-y": "editor::ConfirmCompletion"
    }
  },
  {
    "context": "Editor  &&  vim_mode ==  normal",
    "bindings": {
      "space d m": "workspace::ToggleCenteredLayout"
    }
  }
]
