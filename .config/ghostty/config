### TMUX

keybind = super+t=text:\x00\x63
keybind = super+w=text:\x00x
keybind = super+k=text:\x00k

keybind = super+d=text:\x00v
keybind = super+shift+d=text:\x00\"
keybind = ctrl+tab=text:\x00l

